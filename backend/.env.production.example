# Production API server (tekeyeapi.clickmasters.pk)
# Copy to /var/www/customs/backend/.env — ML is intentionally disabled.

DEBUG=False
SECRET_KEY=change-me-generate-with-get_random_secret_key

ALLOWED_HOSTS=tekeyeapi.clickmasters.pk

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://tekeye.clickmasters.pk,https://www.tekeye.clickmasters.pk
FRONTEND_ORIGIN=https://tekeye.clickmasters.pk

DB_NAME=tekeye_peshawer
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_PHONE=

FILE_UPLOAD_MAX_MEMORY_SIZE=104857600
DATA_UPLOAD_MAX_MEMORY_SIZE=104857600

# ML disabled — do not run ml_services on this host
ML_SERVICE_URL=
ML_SERVICE_PUBLIC_URL=

DETECTION_WORKER_ENABLED=False
DETECTION_WORKER_AUTO_START=False

ATTENDANCE_MARK_ON_FACE_RECOGNITION_CAMERAS=False
ATTENDANCE_SNAPSHOT_ENABLED=False
